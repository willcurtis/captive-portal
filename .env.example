NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PORTAL_BIND_IP=192.0.2.10
PORTAL_DOMAIN=wifi.example.com
PUBLIC_ORIGIN=https://wifi.example.com

# From Network > Control Plane > Integrations. Use the exact local base URL.
UNIFI_API_BASE_URL=https://192.0.2.1/proxy/network/integration/v1
UNIFI_API_KEY_FILE=/run/secrets/unifi_api_key
UNIFI_SITE_ID=00000000-0000-0000-0000-000000000000
UNIFI_SITE_SLUG=default
UNIFI_CA_FILE=/run/secrets/unifi_ca

ALLOWED_SSIDS=Guest WiFi
AUTHORIZATION_MINUTES=120
DATA_LIMIT_MBYTES=0
RX_RATE_LIMIT_KBPS=0
TX_RATE_LIMIT_KBPS=0
TRANSACTION_TTL_SECONDS=300
COOKIE_SECRET_FILE=/run/secrets/cookie_secret
COOKIE_SECURE=true
TRUST_PROXY=true
ENFORCE_CLIENT_IP=true
POST_AUTH_REDIRECT_URL=

# Written by install.sh. public-acme, mailinabox-dns01, or manual.
TLS_MODE=public-acme
MIAB_API_URL=
MIAB_EMAIL=
ACME_DNS_RESOLVER=1.1.1.1:53
