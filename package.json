{
  "name": "unifi-captive-portal",
  "version": "2.0.0",
  "private": true,
  "description": "Secure external captive portal for the official UniFi Network Integration API",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.2",
    "fastify": "5.12.1",
    "undici": "8.10.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
